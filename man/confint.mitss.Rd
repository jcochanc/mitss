\name{confint.mitss}
\alias{confint.mitss}
\title{Extract confidence intervals from mitss object}
\usage{
\method{confint}{mitss}(object, parm, level = 0.95, ...)
}
\arguments{
\item{object}{A mitss object}

\item{parm}{Not used (for S3 consistency)}

\item{level}{Confidence level (default 0.95)}

\item{...}{Additional arguments (not used)}
}
\description{
Extracts confidence intervals for the treatment effect from a mitss object.
}
